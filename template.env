# SDE Address Update and Backup - Environment Configuration Template
# Instructions: Copy this file to '.env' and fill in the paths below for your environment

# Path where error logs will be written (directory or file path)
# Example: \\servername\shared_path\logs
ERROR_LOG_NAME=

# Path to the production Enterprise Geodatabase SDE connection file
# This should have sufficient privileges to disconnect users and edit feature classes
# Example: \\servername\gis_data\connections\prod_connection.sde
PROD_EGDB=

# Production feature class name (usually in the format: schema.sde.FeatureClassName)
# Example: dbo.sde.AddressPoints
PROD_FEATURE_CLASS_1=

# Path to the local staging File Geodatabase (FGDB)
# This FGDB contains the staged data to be appended to production
# Example: C:\GIS_Data\staging\staging_data.gdb
LOCAL_FGDB=

# Staging feature class name (the table within LOCAL_FGDB to append from)
# Example: StagedAddressPoints
STAGE_FEATURE_CLASS=

# Path to Excel template file (if used for reporting/tracking)
# This is optional and may not be actively used in current version
# Example: C:\Templates\address_update_template.xlsx
XL_TEMPLET=

# Path to monthly backup/archive geodatabase location (optional)
# Directory where monthly updates are stored
# Example: C:\Backups\monthly_archives
MONTHLY_GDB=

# Monthly feature class shapefile name (optional)
# Filename of the shapefile for monthly updates
# Example: monthly_address_update.shp
MONTHLY_FC=

# Path to safe copy/backup geodatabase
# A copy of the local FGDB is created here for data safety/archival
# Example: \\servername\backup_storage\production_backup.gdb
SAFE_FGDB=
